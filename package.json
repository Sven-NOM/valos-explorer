{
  "name": "valos-explorer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "dev": "vite",
    "build": "npm run build:data && vite build",
    "preview": "vite preview",
    "gh-deploy": "npm run build && cp -r dist /tmp/valos-dist && git checkout gh-pages && git rm -rf . --quiet 2>/dev/null || true && cp -r /tmp/valos-dist/* . && git add . && git commit -m \"Deploy: update built files\" && git push origin gh-pages && git checkout main"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "cheerio": "^1.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  }
}
